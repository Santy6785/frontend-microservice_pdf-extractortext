# ==============================================================================
# Variables de Entorno - Microservicio Front-End
# ==============================================================================

# Nombre de la red externa compartida de Docker (debe coincidir con la del backend)
DOCKER_NETWORK_NAME=pdf-extractortext_pdf-network

# Configuración en runtime inyectada en config.js vía envsubst
API_BASE_PATH=
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_MS=30000
